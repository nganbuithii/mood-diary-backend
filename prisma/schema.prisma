generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MoodType {
  HAPPY
  CALM
  NEUTRAL
  SAD
  ANXIOUS
  ANGRY
  EXCITED
  TIRED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  diaryEntries  DiaryEntry[]
  tags          Tag[]

  @@map("users")
}

// familyId + reuse detection: see mood-diary architecture plan section 6/7.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String
  familyId          String
  revokedAt         DateTime?
  replacedByTokenId String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model DiaryEntry {
  id            String   @id @default(uuid())
  userId        String
  title         String?
  content       String
  moodType      MoodType
  moodIntensity Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags DiaryTag[]

  // Covers `WHERE userId = ? ORDER BY createdAt DESC` (cursor-paginated timeline).
  @@index([userId, createdAt(sort: Desc)])
  @@map("diary_entries")
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  diaries DiaryTag[]

  @@unique([userId, name])
  @@map("tags")
}

model DiaryTag {
  diaryId String
  tagId   String

  diary DiaryEntry @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  tag   Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([diaryId, tagId])
  @@map("diary_tags")
}
