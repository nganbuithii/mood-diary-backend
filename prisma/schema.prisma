generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mood {
  VERY_SAD
  SAD
  NEUTRAL
  HAPPY
  VERY_HAPPY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reminderEnabled Boolean   @default(false)
  // Local hour (0-23) in `timeZone` after which the daily check-in reminder may go out.
  reminderHour    Int       @default(20)
  // IANA zone name, e.g. "Asia/Ho_Chi_Minh"; reported by the browser when reminders are saved.
  timeZone        String    @default("UTC")
  // Local calendar day the last reminder was sent, so a day never gets two.
  reminderSentOn  DateTime? @db.Date

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  moodEntries         MoodEntry[]
  futureLetters       FutureLetter[]
  achievements        UserAchievement[]

  @@index([reminderEnabled])
  @@map("users")
}
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  revokedAt         DateTime?
  replacedByTokenId String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model MoodEntry {
  id             String   @id @default(uuid())
  userId         String
  mood           Mood
  note           String?
  photoUrls      String[] @default([])
  // Snapshot of the chosen song, so the entry survives the song being pulled from the catalog.
  songExternalId String?
  songTitle      String?
  songArtist     String?
  songArtworkUrl String?
  songPreviewUrl String?
  isFavorite     Boolean  @default(false)
  
  deletedAt      DateTime?
  entryDate      DateTime @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, entryDate])
  @@index([userId, mood, entryDate])
  @@index([userId, isFavorite, entryDate])
  @@index([deletedAt])
  @@map("mood_entries")
}

model FutureLetter {
  id            String    @id @default(uuid())
  userId        String
  body          String
  moodAtWriting Mood?
  deliverAt     DateTime
  openedAt      DateTime?
  emailSentAt   DateTime?
  emailAttempts Int       @default(0)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deliverAt])
  @@index([emailSentAt, deliverAt])
  @@map("future_letters")
}

// Highest level reached per achievement. Values are derived from entries on every request;
// only the high-water mark is stored so a level never drops when pages are deleted.
model UserAchievement {
  userId        String
  achievementId String
  level         Int
  // Highest level the user has looked at; anything above it is shown as "new".
  seenLevel     Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}
